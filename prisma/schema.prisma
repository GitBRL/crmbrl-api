// Esquema do banco do CRM BRL (PostgreSQL 17) — Fase 1 (núcleo do CRM) e
// Onda A da Fase 2 (arquivos, atendimento omnichannel, WhatsApp, chat interno).
//
// Convenções:
// - modelos em PascalCase, no singular e em português;
// - tabelas e colunas em snake_case (tabelas no plural), via @@map e @map;
// - ids uuid (EventoAuditoria, LogTecnico e TentativaLogin: bigint sequencial);
// - datas sempre em timestamptz(3), com `criadoEm`/`atualizadoEm` em todos os
//   modelos (o masculino vale para qualquer registro, para não errar o nome);
// - valores em Decimal(14,2); exclusão lógica com `excluidoEm` onde indicado.
//
// Regras que o banco garante sozinho (SQL nas migrations `fase1_nucleo` e
// `onda_a_atendimento`):
// - índices únicos parciais (preview `partialIndexes`, declarados aqui com `where`);
// - CHECKs de valores e da normalização do e-mail do usuário;
// - o gatilho que recusa UPDATE, DELETE e TRUNCATE em `eventos_auditoria` (R3.3);
// - o contato com pelo menos um meio de contato — e-mail, telefone ou um
//   identificador de canal (R4.1), conferido no fim da transação;
// - `usuarios.acesso_ativado_em`, preenchido quando a pessoa passa a ter senha
//   própria (R5.8, ajuste da Onda A);
// - os avisos `pg_notify('crmbrl_sessoes_revogadas', <id>)` quando uma sessão é
//   revogada (o tempo real derruba os sockets dela) e
//   `pg_notify('crmbrl_notificacoes', { id, usuarioId })` quando nasce uma
//   notificação (o tempo real a entrega na hora).
//
// A URL de conexão fica no prisma.config.ts (Prisma 7), não aqui.
// Nunca edite uma migration já aplicada: mude este arquivo e gere outra com
// `bun run prisma:migrar --name <o-que-mudou>`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // O projeto compila para CommonJS; imports sem extensão funcionam no tsc,
  // no Jest e no Node sem mapeamento extra.
  moduleFormat        = "cjs"
  importFileExtension = ""
  // Índices únicos parciais (dedup de contatos, CNPJ, um funil-base por área,
  // uma etapa de ganho e uma de perda por funil) ficam no schema, para o
  // `migrate dev` conhecê-los e nunca propor apagá-los.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Papel de quem usa o CRM. Define o que a pessoa vê e pode fazer (R1).
enum Papel {
  ADMIN
  C_LEVEL
  LIDER_COMERCIAL
  COMERCIAL
  LIDER_MARKETING
  MARKETING
  LIDER_CS
  CS

  @@map("papel")
}

/// Área de negócio. Cada funil pertence a uma; cada papel de líder ou de membro também (R1).
enum Area {
  MARKETING
  COMERCIAL
  CS

  @@map("area")
}

/// Tipo da etapa: o status do negócio deriva dele (R5.2, R5.3).
enum TipoEtapa {
  ABERTA
  GANHO
  PERDIDO

  @@map("tipo_etapa")
}

enum StatusNegocio {
  ABERTO
  GANHO
  PERDIDO

  @@map("status_negocio")
}

/// De onde veio o contato ou o negócio (R4.3).
enum OrigemContato {
  MANUAL
  WEBHOOK
  WHATSAPP
  SITE
  INDICACAO
  IMPORTACAO
  PASSAGEM
  OUTRO
  /// Onda A: contatos que chegam pelos canais do Atendimento (WhatsApp e SITE já existiam).
  EMAIL
  INSTAGRAM
  MESSENGER

  @@map("origem_contato")
}

enum TipoAtividade {
  TAREFA
  LIGACAO
  REUNIAO
  EMAIL
  WHATSAPP
  NOTA

  @@map("tipo_atividade")
}

enum StatusAtividade {
  PENDENTE
  CONCLUIDA
  CANCELADA

  @@map("status_atividade")
}

enum PrioridadeAtividade {
  BAIXA
  MEDIA
  ALTA

  @@map("prioridade_atividade")
}

/// Quem fez a alteração (R3.1).
enum TipoAtor {
  USUARIO
  SISTEMA
  WEBHOOK
  AUTOMACAO
  IA

  @@map("tipo_ator")
}

/// Como um negócio criado por automação ganha responsável (R5.8, R8.1).
enum EstrategiaDistribuicao {
  RODIZIO
  RESPONSAVEL_FIXO
  LIDER_DA_AREA

  @@map("estrategia_distribuicao")
}

enum TipoTokenSenha {
  CONVITE
  REDEFINICAO

  @@map("tipo_token_senha")
}

enum StatusRecebimento {
  RECEBIDO
  PROCESSADO
  IGNORADO
  ERRO

  @@map("status_recebimento")
}

enum StatusEntrega {
  PENDENTE
  ENTREGUE
  FALHOU

  @@map("status_entrega")
}

enum NivelLog {
  DEBUG
  INFO
  AVISO
  ERRO

  @@map("nivel_log")
}

/// Modelo de mapeamento de um webhook de entrada (R8.1).
enum ModeloMapeamento {
  GENERICO
  DISPAROS_BRL
  PERSONALIZADO

  @@map("modelo_mapeamento")
}

// ---------------------------------------------------------------------------
// Usuários e autenticação (R1, R2)
// ---------------------------------------------------------------------------

/// Pessoa com acesso ao CRM.
///
/// `liderId` aponta para o líder: membro → líder da área; líder → C-level.
/// Quando alguém é desligado, o que estava com ele vai para esse líder (R7).
/// O e-mail é gravado aparado e em minúsculas (R1.1; um CHECK garante).
/// `senhaHash` fica nulo para quem foi convidado e ainda não definiu a senha.
model Usuario {
  id              String    @id @default(uuid()) @db.Uuid
  nome            String
  email           String    @unique
  papel           Papel
  liderId         String?   @map("lider_id") @db.Uuid
  lider           Usuario?  @relation("Lideranca", fields: [liderId], references: [id], onDelete: SetNull)
  liderados       Usuario[] @relation("Lideranca")
  ativo           Boolean   @default(true)
  desligadoEm     DateTime? @map("desligado_em") @db.Timestamptz(3)
  /// `scrypt$N$r$p$sal$hash` (R2.1). Nunca sai da API.
  senhaHash       String?   @map("senha_hash")
  /// Troca de senha obrigatória no próximo acesso (R2.6, R2.7, R2.8).
  deveTrocarSenha Boolean   @default(false) @map("deve_trocar_senha")
  senhaAlteradaEm DateTime? @map("senha_alterada_em") @db.Timestamptz(3)
  ultimoAcessoEm  DateTime? @map("ultimo_acesso_em") @db.Timestamptz(3)
  /// Quando a pessoa passou a ter senha própria (definiu a do convite ou trocou a
  /// temporária / a inicial). Preenchido pelo banco (gatilho); nulo = ainda não
  /// ativou o acesso e fica fora dos rodízios de leads e de conversas (R5.8, R12).
  acessoAtivadoEm DateTime? @map("acesso_ativado_em") @db.Timestamptz(3)
  avatarUrl       String?   @map("avatar_url")
  telefone        String?
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  sessoes                    Sessao[]
  tokensSenha                TokenSenha[]
  empresasResponsavel        Empresa[]                       @relation("EmpresaResponsavel")
  empresasCriadas            Empresa[]                       @relation("EmpresaCriadoPor")
  contatosResponsavel        Contato[]                       @relation("ContatoResponsavel")
  contatosCriados            Contato[]                       @relation("ContatoCriadoPor")
  negociosResponsavel        Negocio[]                       @relation("NegocioResponsavel")
  negociosCriados            Negocio[]                       @relation("NegocioCriadoPor")
  movimentacoes              NegocioMovimentacao[]
  passagensResponsavelFixo   Passagem[]                      @relation("PassagemResponsavelFixo")
  regrasDistribuicaoUltimo   RegraDistribuicao[]             @relation("RegraDistribuicaoUltimo")
  participacoesDistribuicao  RegraDistribuicaoParticipante[]
  atividadesResponsavel      Atividade[]                     @relation("AtividadeResponsavel")
  atividadesCriadas          Atividade[]                     @relation("AtividadeCriadoPor")
  atividadesConcluidas       Atividade[]                     @relation("AtividadeConcluidaPor")
  atividadesEncaminhadas     Atividade[]                     @relation("AtividadeEncaminhadaDe")
  notificacoes               Notificacao[]
  webhooksEntradaResponsavel WebhookEntrada[]                @relation("WebhookEntradaResponsavelFixo")
  webhooksEntradaCriados     WebhookEntrada[]                @relation("WebhookEntradaCriadoPor")
  webhooksSaidaCriados       WebhookSaida[]                  @relation("WebhookSaidaCriadoPor")
  // Onda A
  arquivosCriados            Arquivo[]                       @relation("ArquivoCriadoPor")
  canaisCriados              Canal[]                         @relation("CanalCriadoPor")
  filasUltimoUsuario         FilaAtendimento[]               @relation("FilaUltimoUsuario")
  participacoesFilas         FilaParticipante[]
  conversasResponsavel       Conversa[]                      @relation("ConversaResponsavel")
  conversasResolvidas        Conversa[]                      @relation("ConversaResolvidaPor")
  atribuicoesDe              ConversaAtribuicao[]            @relation("AtribuicaoDeUsuario")
  atribuicoesPara            ConversaAtribuicao[]            @relation("AtribuicaoParaUsuario")
  atribuicoesFeitas          ConversaAtribuicao[]            @relation("AtribuicaoPorUsuario")
  mensagensAutor             Mensagem[]                      @relation("MensagemAutor")
  respostasRapidasCriadas    RespostaRapida[]                @relation("RespostaRapidaCriadaPor")
  chatCanaisCriados          ChatCanal[]                     @relation("ChatCanalCriadoPor")
  chatParticipacoes          ChatMembro[]
  chatMensagens              ChatMensagem[]                  @relation("ChatMensagemAutor")

  @@index([liderId])
  @@index([papel, ativo])
  @@map("usuarios")
}

/// Sessão de login (R2.2). O cookie `crmbrl_sessao` leva o token; aqui fica só o SHA-256.
/// `expiraEm` = mínimo entre (último uso + inatividade) e (criação + duração máxima).
model Sessao {
  id              String    @id @default(uuid()) @db.Uuid
  usuarioId       String    @map("usuario_id") @db.Uuid
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique @map("token_hash")
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  ultimoUsoEm     DateTime  @default(now()) @map("ultimo_uso_em") @db.Timestamptz(3)
  expiraEm        DateTime  @map("expira_em") @db.Timestamptz(3)
  revogadaEm      DateTime? @map("revogada_em") @db.Timestamptz(3)
  /// `logout`, `desligamento`, `troca_de_senha`, `redefinicao_de_senha`, `senha_temporaria`, `usuario_inativo`.
  motivoRevogacao String?   @map("motivo_revogacao")
  ip              String?
  userAgent       String?   @map("user_agent")

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

/// Toda tentativa de login, com sucesso ou não (R2.5). Base do bloqueio por força bruta.
model TentativaLogin {
  id        BigInt   @id @default(autoincrement())
  /// E-mail normalizado (aparado, minúsculas), exista ou não um usuário com ele.
  email     String
  ip        String?
  usuarioId String?  @map("usuario_id") @db.Uuid
  sucesso   Boolean
  /// `SUCESSO`, `SENHA_INCORRETA`, `USUARIO_INEXISTENTE`, `SEM_SENHA`, `USUARIO_DESLIGADO`, `BLOQUEADO_EMAIL`, `BLOQUEADO_IP`.
  motivo    String
  userAgent String?  @map("user_agent")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

/// Token de uso único para convite ou redefinição de senha (R2.8). Só o hash fica no banco.
model TokenSenha {
  id           String         @id @default(uuid()) @db.Uuid
  usuarioId    String         @map("usuario_id") @db.Uuid
  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo         TipoTokenSenha
  tokenHash    String         @unique @map("token_hash")
  criadoPorId  String?        @map("criado_por_id") @db.Uuid
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  expiraEm     DateTime       @map("expira_em") @db.Timestamptz(3)
  usadoEm      DateTime?      @map("usado_em") @db.Timestamptz(3)
  /// Preenchido quando um token mais novo do mesmo tipo substitui este.
  invalidadoEm DateTime?      @map("invalidado_em") @db.Timestamptz(3)

  @@index([usuarioId, tipo])
  @@map("tokens_senha")
}

// ---------------------------------------------------------------------------
// Contatos e empresas (R4)
// ---------------------------------------------------------------------------

/// Empresa (R4.4). CNPJ só com dígitos, único entre as empresas não excluídas.
model Empresa {
  id                   String    @id @default(uuid()) @db.Uuid
  nome                 String
  /// 14 dígitos, validado pelos dígitos verificadores.
  cnpj                 String?
  site                 String?
  email                String?
  telefone             String?
  segmento             String?
  cidade               String?
  uf                   String?   @db.Char(2)
  responsavelId        String?   @map("responsavel_id") @db.Uuid
  responsavel          Usuario?  @relation("EmpresaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  etiquetas            String[]  @default([])
  camposPersonalizados Json      @default("{}") @map("campos_personalizados")
  criadoPorId          String?   @map("criado_por_id") @db.Uuid
  criadoPor            Usuario?  @relation("EmpresaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm             DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  excluidoEm           DateTime? @map("excluido_em") @db.Timestamptz(3)

  contatos   Contato[]
  negocios   Negocio[]
  atividades Atividade[]

  @@unique([cnpj], map: "empresas_cnpj_ativo_key", where: raw("(cnpj IS NOT NULL) AND (excluido_em IS NULL)"))
  @@index([responsavelId])
  @@index([nome])
  @@map("empresas")
}

/// Pessoa de contato (R4). E-mail em minúsculas; telefone em E.164 só com dígitos.
/// Os índices únicos parciais de e-mail e telefone garantem a deduplicação (R4.2)
/// mesmo sob concorrência: um segundo INSERT com o mesmo valor falha com P2002.
/// Precisa de e-mail, telefone ou pelo menos um `ContatoIdentificador` (ex.: só o
/// id do Instagram) — conferido no fim da transação (gatilho adiável, R4.1).
model Contato {
  id                    String        @id @default(uuid()) @db.Uuid
  nome                  String
  email                 String?
  telefone              String?
  cargo                 String?
  empresaId             String?       @map("empresa_id") @db.Uuid
  empresa               Empresa?      @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  responsavelId         String?       @map("responsavel_id") @db.Uuid
  responsavel           Usuario?      @relation("ContatoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  /// Primeira origem (R4.3): imutável depois da criação.
  primeiraOrigem        OrigemContato @default(MANUAL) @map("primeira_origem")
  primeiraOrigemDetalhe String?       @map("primeira_origem_detalhe")
  /// `{ source, medium, campaign, term, content }` (tipo `Utm`).
  primeiraOrigemUtm     Json?         @map("primeira_origem_utm")
  /// Última origem (R4.3): muda a cada reconversão.
  ultimaOrigem          OrigemContato @default(MANUAL) @map("ultima_origem")
  ultimaOrigemDetalhe   String?       @map("ultima_origem_detalhe")
  ultimaOrigemUtm       Json?         @map("ultima_origem_utm")
  ultimaOrigemEm        DateTime      @default(now()) @map("ultima_origem_em") @db.Timestamptz(3)
  /// Quantas vezes o contato chegou (1 na criação, +1 a cada reconversão).
  conversoes            Int           @default(1)
  etiquetas             String[]      @default([])
  camposPersonalizados  Json          @default("{}") @map("campos_personalizados")
  /// LGPD (R4.6): fora de disparos e automações de marketing.
  optOutMarketing       Boolean       @default(false) @map("opt_out_marketing")
  optOutEm              DateTime?     @map("opt_out_em") @db.Timestamptz(3)
  consentimentoEm       DateTime?     @map("consentimento_em") @db.Timestamptz(3)
  consentimentoOrigem   String?       @map("consentimento_origem")
  criadoPorId           String?       @map("criado_por_id") @db.Uuid
  criadoPor             Usuario?      @relation("ContatoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm              DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm          DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  /// Exclusão lógica com anonimização (R4.6).
  excluidoEm            DateTime?     @map("excluido_em") @db.Timestamptz(3)

  negocios            Negocio[]
  atividades          Atividade[]
  recebimentosWebhook WebhookRecebimento[]
  // Onda A
  identificadores     ContatoIdentificador[]
  conversas           Conversa[]
  visitantesWebchat   WebchatVisitante[]

  @@unique([email], map: "contatos_email_ativo_key", where: raw("(email IS NOT NULL) AND (excluido_em IS NULL)"))
  @@unique([telefone], map: "contatos_telefone_ativo_key", where: raw("(telefone IS NOT NULL) AND (excluido_em IS NULL)"))
  @@index([responsavelId])
  @@index([empresaId])
  @@index([criadoEm])
  @@map("contatos")
}

// ---------------------------------------------------------------------------
// Funis, etapas, negócios e passagens (R5)
// ---------------------------------------------------------------------------

/// Funil kanban. Os três funis-base (`base = true`, um por área) não podem ser excluídos (R5.1).
/// `ativo = false` arquiva (some do kanban, volta quando reativado); `excluidoEm`
/// é a exclusão lógica de um funil extra, que preserva o histórico dos negócios.
model Funil {
  id           String    @id @default(uuid()) @db.Uuid
  nome         String
  area         Area
  base         Boolean   @default(false)
  ordem        Int       @default(0)
  ativo        Boolean   @default(true)
  descricao    String?
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  excluidoEm   DateTime? @map("excluido_em") @db.Timestamptz(3)

  etapas           Etapa[]
  negocios         Negocio[]
  movimentacoes    NegocioMovimentacao[]
  passagensOrigem  Passagem[]            @relation("PassagemFunilOrigem")
  passagensDestino Passagem[]            @relation("PassagemFunilDestino")
  webhooksEntrada  WebhookEntrada[]

  @@unique([area], map: "funis_base_area_key", where: raw("base"))
  @@index([area, ordem])
  @@map("funis")
}

/// Etapa de um funil (R5.2). Exatamente uma de ganho e uma de perda por funil
/// (índices únicos parciais). `chave` identifica as etapas criadas pela
/// configuração inicial (ex.: `qualificado_mql`), estável mesmo se renomeadas.
model Etapa {
  id            String    @id @default(uuid()) @db.Uuid
  funilId       String    @map("funil_id") @db.Uuid
  funil         Funil     @relation(fields: [funilId], references: [id], onDelete: Cascade)
  nome          String
  chave         String?
  ordem         Int
  tipo          TipoEtapa @default(ABERTA)
  /// Prazo-alvo em dias: acima dele o negócio está "parado" (R5.10).
  prazoDias     Int?      @map("prazo_dias")
  /// 0 a 100.
  probabilidade Int?
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  negocios          Negocio[]
  movimentacoesDe   NegocioMovimentacao[] @relation("MovimentacaoDeEtapa")
  movimentacoesPara NegocioMovimentacao[] @relation("MovimentacaoParaEtapa")
  passagensGatilho  Passagem[]            @relation("PassagemEtapaGatilho")
  passagensDestino  Passagem[]            @relation("PassagemEtapaDestino")
  webhooksEntrada   WebhookEntrada[]

  @@unique([funilId, chave])
  @@unique([funilId], map: "etapas_funil_ganho_key", where: raw("(tipo = 'GANHO'::tipo_etapa)"))
  @@unique([funilId], map: "etapas_funil_perdido_key", where: raw("(tipo = 'PERDIDO'::tipo_etapa)"))
  @@index([funilId, ordem])
  @@map("etapas")
}

/// Negócio (oportunidade) num funil (R5.3). `status` deriva do tipo da etapa.
model Negocio {
  id                   String        @id @default(uuid()) @db.Uuid
  /// Padrão: nome do contato ou da empresa.
  titulo               String
  contatoId            String        @map("contato_id") @db.Uuid
  contato              Contato       @relation(fields: [contatoId], references: [id], onDelete: Restrict)
  empresaId            String?       @map("empresa_id") @db.Uuid
  empresa              Empresa?      @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  funilId              String        @map("funil_id") @db.Uuid
  funil                Funil         @relation(fields: [funilId], references: [id], onDelete: Restrict)
  etapaId              String        @map("etapa_id") @db.Uuid
  etapa                Etapa         @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  /// Nulo = sem responsável (o membro da área pode assumir, R5.9).
  responsavelId        String?       @map("responsavel_id") @db.Uuid
  responsavel          Usuario?      @relation("NegocioResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  status               StatusNegocio @default(ABERTO)
  /// Em reais, ≥ 0, duas casas (CHECK).
  valor                Decimal       @default(0) @db.Decimal(14, 2)
  /// Valor recorrente mensal, ≥ 0 (CHECK).
  valorRecorrente      Decimal?      @map("valor_recorrente") @db.Decimal(14, 2)
  previsaoFechamento   DateTime?     @map("previsao_fechamento") @db.Date
  motivoPerda          String?       @map("motivo_perda")
  ganhoEm              DateTime?     @map("ganho_em") @db.Timestamptz(3)
  perdidoEm            DateTime?     @map("perdido_em") @db.Timestamptz(3)
  /// Desde quando está na etapa atual.
  etapaDesde           DateTime      @default(now()) @map("etapa_desde") @db.Timestamptz(3)
  /// Ordenação fracionária no kanban (dentro da etapa).
  posicao              Float         @default(0)
  /// Negócio que originou este por uma passagem (R5.7).
  negocioOrigemId      String?       @map("negocio_origem_id") @db.Uuid
  negocioOrigem        Negocio?      @relation("NegocioOrigem", fields: [negocioOrigemId], references: [id], onDelete: SetNull)
  negociosDerivados    Negocio[]     @relation("NegocioOrigem")
  origem               OrigemContato @default(MANUAL)
  origemDetalhe        String?       @map("origem_detalhe")
  /// `{ source, medium, campaign, term, content }` (tipo `Utm`).
  utm                  Json?
  /// Reconversões registradas neste negócio (R5.6).
  reconversoes         Int           @default(0)
  ultimaReconversaoEm  DateTime?     @map("ultima_reconversao_em") @db.Timestamptz(3)
  camposPersonalizados Json          @default("{}") @map("campos_personalizados")
  criadoPorId          String?       @map("criado_por_id") @db.Uuid
  criadoPor            Usuario?      @relation("NegocioCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm             DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  excluidoEm           DateTime?     @map("excluido_em") @db.Timestamptz(3)

  movimentacoes              NegocioMovimentacao[]
  atividades                 Atividade[]
  passagensExecutadasOrigem  PassagemExecucao[]    @relation("ExecucaoNegocioOrigem")
  passagensExecutadasDestino PassagemExecucao[]    @relation("ExecucaoNegocioDestino")
  recebimentosWebhook        WebhookRecebimento[]
  conversas                  Conversa[]

  @@index([funilId, etapaId, status])
  @@index([etapaId, posicao])
  @@index([responsavelId, status])
  @@index([contatoId])
  @@index([empresaId])
  @@index([negocioOrigemId])
  @@map("negocios")
}

/// Histórico de movimentação (R5.4) — base das métricas (R5.10). A entrada do
/// negócio no funil é registrada com `deEtapaId` nulo.
model NegocioMovimentacao {
  id                      String   @id @default(uuid()) @db.Uuid
  negocioId               String   @map("negocio_id") @db.Uuid
  negocio                 Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  funilId                 String   @map("funil_id") @db.Uuid
  funil                   Funil    @relation(fields: [funilId], references: [id], onDelete: Cascade)
  deEtapaId               String?  @map("de_etapa_id") @db.Uuid
  deEtapa                 Etapa?   @relation("MovimentacaoDeEtapa", fields: [deEtapaId], references: [id], onDelete: SetNull)
  /// Nulo só se a etapa for excluída depois (o histórico fica).
  paraEtapaId             String?  @map("para_etapa_id") @db.Uuid
  paraEtapa               Etapa?   @relation("MovimentacaoParaEtapa", fields: [paraEtapaId], references: [id], onDelete: SetNull)
  usuarioId               String?  @map("usuario_id") @db.Uuid
  usuario                 Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tipoAtor                TipoAtor @map("tipo_ator")
  segundosNaEtapaAnterior Int?     @map("segundos_na_etapa_anterior")
  criadoEm                DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([negocioId, criadoEm])
  @@index([funilId, criadoEm])
  @@index([paraEtapaId])
  @@index([deEtapaId])
  @@map("negocio_movimentacoes")
}

/// Passagem automática entre funis (R5.7), executada na transação da movimentação.
model Passagem {
  id                String                 @id @default(uuid()) @db.Uuid
  /// Identifica as passagens da configuração inicial (`marketing_comercial`, `comercial_cs`).
  chave             String?                @unique
  nome              String
  funilOrigemId     String                 @map("funil_origem_id") @db.Uuid
  funilOrigem       Funil                  @relation("PassagemFunilOrigem", fields: [funilOrigemId], references: [id], onDelete: Restrict)
  etapaGatilhoId    String                 @map("etapa_gatilho_id") @db.Uuid
  etapaGatilho      Etapa                  @relation("PassagemEtapaGatilho", fields: [etapaGatilhoId], references: [id], onDelete: Restrict)
  funilDestinoId    String                 @map("funil_destino_id") @db.Uuid
  funilDestino      Funil                  @relation("PassagemFunilDestino", fields: [funilDestinoId], references: [id], onDelete: Restrict)
  etapaDestinoId    String                 @map("etapa_destino_id") @db.Uuid
  etapaDestino      Etapa                  @relation("PassagemEtapaDestino", fields: [etapaDestinoId], references: [id], onDelete: Restrict)
  estrategia        EstrategiaDistribuicao @default(RODIZIO)
  responsavelFixoId String?                @map("responsavel_fixo_id") @db.Uuid
  responsavelFixo   Usuario?               @relation("PassagemResponsavelFixo", fields: [responsavelFixoId], references: [id], onDelete: SetNull)
  ativa             Boolean                @default(true)
  criadoEm          DateTime               @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm      DateTime               @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  execucoes PassagemExecucao[]

  @@index([etapaGatilhoId])
  @@map("passagens")
}

/// Cada passagem roda uma única vez por negócio de origem (R5.7): o índice único garante.
/// `negocioDestinoId` é o negócio criado — ou o aberto que recebeu a reconversão (`reconversao = true`, R5.6).
model PassagemExecucao {
  id               String   @id @default(uuid()) @db.Uuid
  passagemId       String   @map("passagem_id") @db.Uuid
  passagem         Passagem @relation(fields: [passagemId], references: [id], onDelete: Cascade)
  negocioOrigemId  String   @map("negocio_origem_id") @db.Uuid
  negocioOrigem    Negocio  @relation("ExecucaoNegocioOrigem", fields: [negocioOrigemId], references: [id], onDelete: Cascade)
  negocioDestinoId String?  @map("negocio_destino_id") @db.Uuid
  negocioDestino   Negocio? @relation("ExecucaoNegocioDestino", fields: [negocioDestinoId], references: [id], onDelete: SetNull)
  reconversao      Boolean  @default(false)
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@unique([passagemId, negocioOrigemId])
  @@index([negocioDestinoId])
  @@map("passagem_execucoes")
}

/// Rodízio de uma área (R5.8). `ultimoUsuarioId` é o ponteiro; trave a linha
/// (`SELECT … FOR UPDATE`) antes de escolher o próximo.
model RegraDistribuicao {
  id              String   @id @default(uuid()) @db.Uuid
  area            Area     @unique
  /// O líder da área entra no rodízio.
  incluirLideres  Boolean  @default(false) @map("incluir_lideres")
  ultimoUsuarioId String?  @map("ultimo_usuario_id") @db.Uuid
  ultimoUsuario   Usuario? @relation("RegraDistribuicaoUltimo", fields: [ultimoUsuarioId], references: [id], onDelete: SetNull)
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  participantes RegraDistribuicaoParticipante[]

  @@map("regras_distribuicao")
}

/// Ajuste manual do rodízio: `participa = false` tira o usuário; `true` inclui
/// explicitamente (ex.: um líder quando `incluirLideres` é falso).
model RegraDistribuicaoParticipante {
  id           String            @id @default(uuid()) @db.Uuid
  regraId      String            @map("regra_id") @db.Uuid
  regra        RegraDistribuicao @relation(fields: [regraId], references: [id], onDelete: Cascade)
  usuarioId    String            @map("usuario_id") @db.Uuid
  usuario      Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  participa    Boolean           @default(false)
  criadoEm     DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@unique([regraId, usuarioId])
  @@index([usuarioId])
  @@map("regras_distribuicao_participantes")
}

// ---------------------------------------------------------------------------
// Atividades (R6)
// ---------------------------------------------------------------------------

/// Tarefa, ligação, reunião, e-mail, WhatsApp ou nota (R6). "Atrasada" é calculado (R6.3).
model Atividade {
  id                 String              @id @default(uuid()) @db.Uuid
  tipo               TipoAtividade
  titulo             String
  descricao          String?
  status             StatusAtividade     @default(PENDENTE)
  prioridade         PrioridadeAtividade @default(MEDIA)
  venceEm            DateTime?           @map("vence_em") @db.Timestamptz(3)
  /// Reunião: início e fim (R6.1).
  inicioEm           DateTime?           @map("inicio_em") @db.Timestamptz(3)
  fimEm              DateTime?           @map("fim_em") @db.Timestamptz(3)
  responsavelId      String              @map("responsavel_id") @db.Uuid
  responsavel        Usuario             @relation("AtividadeResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  criadoPorId        String?             @map("criado_por_id") @db.Uuid
  criadoPor          Usuario?            @relation("AtividadeCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  concluidaEm        DateTime?           @map("concluida_em") @db.Timestamptz(3)
  concluidaPorId     String?             @map("concluida_por_id") @db.Uuid
  concluidaPor       Usuario?            @relation("AtividadeConcluidaPor", fields: [concluidaPorId], references: [id], onDelete: SetNull)
  canceladaEm        DateTime?           @map("cancelada_em") @db.Timestamptz(3)
  contatoId          String?             @map("contato_id") @db.Uuid
  contato            Contato?            @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  empresaId          String?             @map("empresa_id") @db.Uuid
  empresa            Empresa?            @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  negocioId          String?             @map("negocio_id") @db.Uuid
  negocio            Negocio?            @relation(fields: [negocioId], references: [id], onDelete: SetNull)
  /// Encaminhamento por desligamento (R7.3): de quem veio e quando.
  encaminhadaDeId    String?             @map("encaminhada_de_id") @db.Uuid
  encaminhadaDe      Usuario?            @relation("AtividadeEncaminhadaDe", fields: [encaminhadaDeId], references: [id], onDelete: SetNull)
  encaminhadaEm      DateTime?           @map("encaminhada_em") @db.Timestamptz(3)
  /// Lembretes (R6.5).
  lembreteEnviadoEm  DateTime?           @map("lembrete_enviado_em") @db.Timestamptz(3)
  atrasoNotificadoEm DateTime?           @map("atraso_notificado_em") @db.Timestamptz(3)
  criadoEm           DateTime            @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@index([responsavelId, status, venceEm])
  @@index([status, venceEm])
  @@index([contatoId])
  @@index([empresaId])
  @@index([negocioId])
  @@index([criadoPorId])
  @@map("atividades")
}

// ---------------------------------------------------------------------------
// Notificações, auditoria, logs e eventos (R3, R10)
// ---------------------------------------------------------------------------

/// Notificação interna (R10.2). `tipo` segue `TIPOS_NOTIFICACAO` (src/notificacoes).
model Notificacao {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String
  titulo    String
  texto     String?
  /// Rota do front (ex.: `/funis/comercial?negocio=<id>`).
  link      String?
  dados     Json?
  lidaEm    DateTime? @map("lida_em") @db.Timestamptz(3)
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([usuarioId, lidaEm, criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("notificacoes")
}

/// Evento de auditoria (R3.1–R3.3): somente inclusão. Um gatilho recusa UPDATE,
/// DELETE e TRUNCATE. Sem chave estrangeira para `usuarios`, de propósito: o
/// registro não pode depender de nada que mude depois. `relacionados` guarda
/// referências `entidade:id` (ex.: `contato:<uuid>`) para a linha do tempo (R3.5).
model EventoAuditoria {
  id            BigInt   @id @default(autoincrement())
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  tipoAtor      TipoAtor @map("tipo_ator")
  usuarioId     String?  @map("usuario_id") @db.Uuid
  /// Nome do usuário (ou do webhook, do job…) no momento do evento.
  atorDescricao String?  @map("ator_descricao")
  /// `entidade.verbo`, ex.: `negocio.movido`.
  acao          String
  entidade      String
  entidadeId    String?  @map("entidade_id")
  resumo        String
  /// Campos alterados (`{ campo: { antes, depois } }`) e outros detalhes; nunca senhas, tokens ou segredos.
  dados         Json?
  relacionados  String[] @default([])
  ip            String?
  userAgent     String?  @map("user_agent")
  requisicaoId  String?  @map("requisicao_id")

  @@index([entidade, entidadeId, criadoEm])
  @@index([usuarioId, criadoEm])
  @@index([criadoEm])
  @@index([acao])
  @@index([relacionados], type: Gin)
  @@map("eventos_auditoria")
}

/// Log técnico gravado no banco (R3.6): 5xx, avisos e falhas de jobs. Apagado após 90 dias.
model LogTecnico {
  id           BigInt   @id @default(autoincrement())
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  nivel        NivelLog
  /// Origem (ex.: `HTTP`, `Fila:webhooks-saida.entregar`, `Eventos`).
  contexto     String
  mensagem     String
  dados        Json?
  requisicaoId String?  @map("requisicao_id")
  usuarioId    String?  @map("usuario_id") @db.Uuid
  metodo       String?
  rota         String?
  status       Int?
  duracaoMs    Int?     @map("duracao_ms")

  @@index([criadoEm])
  @@index([nivel, criadoEm])
  @@index([requisicaoId])
  @@map("logs_tecnicos")
}

/// Outbox de eventos de domínio (R10.1). O evento é gravado na transação da
/// alteração; o despachante o entrega à fila (pg-boss) — `enfileiradoEm` — e o
/// trabalhador da fila roda os manipuladores registrados — `processadoEm`.
model EventoDominio {
  id                      String    @id @default(uuid()) @db.Uuid
  /// Ex.: `negocio.ganho` (R9.2).
  tipo                    String
  dados                   Json
  /// Quando aconteceu (o `ocorridoEm` do envelope dos webhooks de saída).
  criadoEm                DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  tipoAtor                TipoAtor  @default(SISTEMA) @map("tipo_ator")
  usuarioId               String?   @map("usuario_id") @db.Uuid
  requisicaoId            String?   @map("requisicao_id")
  /// Quando o despachante criou o job do evento na fila.
  enfileiradoEm           DateTime? @map("enfileirado_em") @db.Timestamptz(3)
  /// Quando todos os manipuladores concluíram.
  processadoEm            DateTime? @map("processado_em") @db.Timestamptz(3)
  tentativas              Int       @default(0)
  /// Manipuladores que já concluíram: na reentrega, só os que faltam rodam.
  manipuladoresConcluidos String[]  @default([]) @map("manipuladores_concluidos")
  /// Erro da última tentativa que falhou.
  erro                    String?

  @@index([criadoEm], map: "eventos_dominio_a_enfileirar_idx", where: raw("(enfileirado_em IS NULL)"))
  @@index([tipo, criadoEm])
  @@map("eventos_dominio")
}

// ---------------------------------------------------------------------------
// Webhooks (R8, R9)
// ---------------------------------------------------------------------------

/// Ponto de entrada de leads (R8.1). O endereço leva um token de 32 bytes; o banco guarda só o hash.
model WebhookEntrada {
  id                  String                 @id @default(uuid()) @db.Uuid
  nome                String
  tokenHash           String                 @unique @map("token_hash")
  /// Começo do token, para reconhecer o endereço na tela sem revelá-lo.
  tokenPrefixo        String                 @map("token_prefixo")
  funilId             String                 @map("funil_id") @db.Uuid
  funil               Funil                  @relation(fields: [funilId], references: [id], onDelete: Restrict)
  etapaId             String                 @map("etapa_id") @db.Uuid
  etapa               Etapa                  @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  estrategia          EstrategiaDistribuicao @default(RODIZIO)
  responsavelFixoId   String?                @map("responsavel_fixo_id") @db.Uuid
  responsavelFixo     Usuario?               @relation("WebhookEntradaResponsavelFixo", fields: [responsavelFixoId], references: [id], onDelete: SetNull)
  modeloMapeamento    ModeloMapeamento       @default(GENERICO) @map("modelo_mapeamento")
  /// Caminho no JSON → campo do contato/negócio.
  mapeamento          Json                   @default("{}")
  etiquetasFixas      String[]               @default([]) @map("etiquetas_fixas")
  /// Segredo HMAC opcional, cifrado com AES-256-GCM (R10.3).
  segredoCifrado      String?                @map("segredo_cifrado")
  ativo               Boolean                @default(true)
  ultimoRecebimentoEm DateTime?              @map("ultimo_recebimento_em") @db.Timestamptz(3)
  criadoPorId         String?                @map("criado_por_id") @db.Uuid
  criadoPor           Usuario?               @relation("WebhookEntradaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm            DateTime               @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm        DateTime               @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  excluidoEm          DateTime?              @map("excluido_em") @db.Timestamptz(3)

  recebimentos WebhookRecebimento[]

  @@map("webhooks_entrada")
}

/// Cada chamada recebida por um webhook de entrada (R8.6). Retenção de 90 dias.
model WebhookRecebimento {
  id           String            @id @default(uuid()) @db.Uuid
  webhookId    String            @map("webhook_id") @db.Uuid
  webhook      WebhookEntrada    @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  recebidoEm   DateTime          @default(now()) @map("recebido_em") @db.Timestamptz(3)
  ip           String?
  /// Subconjunto dos cabeçalhos (sem cookies nem autorização).
  cabecalhos   Json              @default("{}")
  tipoConteudo String?           @map("tipo_conteudo")
  corpo        Json?
  status       StatusRecebimento @default(RECEBIDO)
  mensagem     String?
  contatoId    String?           @map("contato_id") @db.Uuid
  contato      Contato?          @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  negocioId    String?           @map("negocio_id") @db.Uuid
  negocio      Negocio?          @relation(fields: [negocioId], references: [id], onDelete: SetNull)
  processadoEm DateTime?         @map("processado_em") @db.Timestamptz(3)
  tentativas   Int               @default(0)

  @@index([webhookId, recebidoEm])
  @@index([recebidoEm])
  @@index([status])
  @@map("webhook_recebimentos")
}

/// Destino de eventos (R9.1). Segredo e cabeçalhos extras ficam cifrados (R10.3).
model WebhookSaida {
  id                          String    @id @default(uuid()) @db.Uuid
  nome                        String
  url                         String
  /// Eventos assinados (R9.2).
  eventos                     String[]  @default([])
  segredoCifrado              String    @map("segredo_cifrado")
  /// JSON `{ "Cabecalho": "valor" }` cifrado com AES-256-GCM (pode levar credenciais).
  cabecalhosCifrados          String?   @map("cabecalhos_cifrados")
  ativo                       Boolean   @default(true)
  falhasConsecutivas          Int       @default(0) @map("falhas_consecutivas")
  desativadoAutomaticamenteEm DateTime? @map("desativado_automaticamente_em") @db.Timestamptz(3)
  criadoPorId                 String?   @map("criado_por_id") @db.Uuid
  criadoPor                   Usuario?  @relation("WebhookSaidaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm                    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm                DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  excluidoEm                  DateTime? @map("excluido_em") @db.Timestamptz(3)

  entregas WebhookEntrega[]

  @@map("webhooks_saida")
}

/// Entrega de um evento a um destino (R9.4). Uma por (destino, evento): reenviar reaproveita a linha.
model WebhookEntrega {
  id                 String        @id @default(uuid()) @db.Uuid
  webhookId          String        @map("webhook_id") @db.Uuid
  webhook            WebhookSaida  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  /// Id do evento na outbox — também o `id` do envelope (R9.3, R9.6).
  eventoId           String        @map("evento_id") @db.Uuid
  tipoEvento         String        @map("tipo_evento")
  /// Envelope `{ id, evento, ocorridoEm, dados }`.
  payload            Json
  status             StatusEntrega @default(PENDENTE)
  tentativas         Int           @default(0)
  ultimaTentativaEm  DateTime?     @map("ultima_tentativa_em") @db.Timestamptz(3)
  proximaTentativaEm DateTime?     @map("proxima_tentativa_em") @db.Timestamptz(3)
  statusHttp         Int?          @map("status_http")
  duracaoMs          Int?          @map("duracao_ms")
  /// Até 2 KB da resposta.
  trechoResposta     String?       @map("trecho_resposta")
  erro               String?
  entregueEm         DateTime?     @map("entregue_em") @db.Timestamptz(3)
  criadoEm           DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  historicoTentativas WebhookEntregaTentativa[]

  @@unique([webhookId, eventoId])
  @@index([status, proximaTentativaEm])
  @@index([webhookId, criadoEm])
  @@map("webhook_entregas")
}

/// Cada tentativa de entrega (R9.5): status HTTP, duração, até 2 KB da resposta e erro.
model WebhookEntregaTentativa {
  id             String         @id @default(uuid()) @db.Uuid
  entregaId      String         @map("entrega_id") @db.Uuid
  entrega        WebhookEntrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  numero         Int
  sucesso        Boolean
  statusHttp     Int?           @map("status_http")
  duracaoMs      Int?           @map("duracao_ms")
  trechoResposta String?        @map("trecho_resposta")
  erro           String?
  criadoEm       DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([entregaId, numero])
  @@map("webhook_entrega_tentativas")
}

// ===========================================================================
// Onda A da Fase 2 — arquivos, atendimento omnichannel, WhatsApp e chat interno
// (R11 a R15). Todos os modelos da onda ficam aqui, criados de uma vez pela
// migration `onda_a_atendimento`: os módulos de canais, atendimento e chat não
// mudam o schema.
// ===========================================================================

// ---------------------------------------------------------------------------
// Enums da Onda A
// ---------------------------------------------------------------------------

/// Para que serve o arquivo. Define o limite de tamanho e quem pode baixá-lo (R11):
/// a permissão é a do item a que o arquivo pertence.
enum ContextoArquivo {
  /// Anexo de mensagem do Atendimento (quem vê a conversa vê o arquivo).
  MENSAGEM
  /// Anexo do chat interno (só os membros do canal).
  CHAT
  /// Planilha de importação de contatos (Onda B).
  IMPORTACAO
  /// Foto de usuário ou de contato (qualquer usuário logado).
  AVATAR
  OUTRO

  @@map("contexto_arquivo")
}

/// Canal de atendimento (R12–R14).
enum TipoCanal {
  WHATSAPP
  WEBCHAT
  EMAIL
  INSTAGRAM
  MESSENGER

  @@map("tipo_canal")
}

/// Tipo do identificador que liga uma pessoa num canal ao contato do CRM.
enum TipoIdentificador {
  /// Telefone do WhatsApp em E.164 só com dígitos (o formato de `contatos.telefone`).
  WHATSAPP
  /// Identificador `@lid` do WhatsApp (conta que não mostra o telefone).
  WHATSAPP_LID
  /// Endereço de e-mail, em minúsculas.
  EMAIL
  /// IGSID: id da pessoa na conta do Instagram.
  INSTAGRAM
  /// PSID: id da pessoa na página do Facebook (Messenger).
  MESSENGER
  /// Id do visitante do chat do site (`webchat_visitantes.id`).
  WEBCHAT

  @@map("tipo_identificador")
}

/// ABERTA e PENDENTE contam como "em aberto": um contato tem no máximo uma conversa
/// em aberto por canal (R12, índice único parcial).
enum StatusConversa {
  ABERTA
  /// Aguardando o contato (ou outra pessoa); continua em aberto.
  PENDENTE
  RESOLVIDA

  @@map("status_conversa")
}

enum PrioridadeConversa {
  BAIXA
  NORMAL
  ALTA
  URGENTE

  @@map("prioridade_conversa")
}

enum DirecaoMensagem {
  /// Do contato para o CRM.
  ENTRADA
  /// Do CRM (atendente, automação) para o contato.
  SAIDA
  /// Nota interna: só a equipe vê; nunca vai ao contato.
  INTERNA
  /// Aviso do sistema na conversa (transferida, resolvida, reaberta…).
  SISTEMA

  @@map("direcao_mensagem")
}

enum TipoMensagem {
  TEXTO
  IMAGEM
  AUDIO
  VIDEO
  DOCUMENTO
  LOCALIZACAO
  CONTATO
  FIGURINHA
  REACAO

  @@map("tipo_mensagem")
}

/// Situação de uma mensagem de saída: PENDENTE → ENVIADA → ENTREGUE → LIDA, ou FALHOU.
enum StatusMensagem {
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU

  @@map("status_mensagem")
}

/// Como a fila escolhe o responsável de uma conversa nova (R12).
enum EstrategiaFila {
  /// Rodízio entre os participantes (ou os membros ativos da área da fila).
  RODIZIO
  /// Quem tem menos conversas em aberto.
  MENOR_CARGA
  /// Ninguém é escolhido: a conversa fica sem responsável até alguém assumir.
  MANUAL

  @@map("estrategia_fila")
}

/// Conexão de um número no gateway de WhatsApp (R13).
enum StatusWhatsapp {
  DESCONECTADO
  AGUARDANDO_QR
  CONECTANDO
  CONECTADO
  ERRO
  BANIDO

  @@map("status_whatsapp")
}

/// Por que a conversa mudou de mãos (histórico `conversa_atribuicoes`).
enum MotivoAtribuicao {
  /// Escolhido pela fila (rodízio, menor carga).
  DISTRIBUICAO
  /// Alguém assumiu uma conversa sem responsável.
  ASSUMIDA
  /// Transferida para outra pessoa ou fila, com nota.
  TRANSFERENCIA
  /// O responsável foi desligado (R7).
  DESLIGAMENTO
  /// Conversa reaberta.
  REABERTURA
  /// Atribuição feita à mão por líder, C-level ou Admin.
  MANUAL

  @@map("motivo_atribuicao")
}

/// Tipo de canal do chat interno da equipe (R15).
enum TipoChatCanal {
  /// "Geral": todos os usuários ativos.
  GERAL
  /// Um por área: membros automáticos pelo papel.
  AREA
  /// Grupo criado por qualquer usuário.
  GRUPO
  /// Conversa direta entre duas pessoas: privada (nem o Admin lê).
  DIRETO

  @@map("tipo_chat_canal")
}

// ---------------------------------------------------------------------------
// Arquivos (R11)
// ---------------------------------------------------------------------------

/// Arquivo guardado no bucket (MinIO/S3). O download passa sempre pela API
/// (`GET /api/v1/arquivos/:id`), com a permissão do item a que pertence.
model Arquivo {
  id               String          @id @default(uuid()) @db.Uuid
  /// Chave do objeto no bucket (`<contexto>/<aaaa>/<mm>/<id>`). Nunca sai da API.
  chave            String          @unique
  /// Nome original, já limpo (sem caminho nem caracteres de controle).
  nome             String
  /// Tipo MIME aceito pela política de arquivos (SVG e HTML são recusados).
  mime             String
  /// Em bytes.
  tamanho          Int
  /// SHA-256 do conteúdo, em hexadecimal.
  sha256           String          @db.Char(64)
  contexto         ContextoArquivo
  /// Imagens e vídeos: dimensões, quando conhecidas.
  largura          Int?
  altura           Int?
  /// Áudio e vídeo: duração, quando conhecida.
  duracaoSegundos  Int?            @map("duracao_segundos")
  /// Nulo quando veio de fora (mídia recebida por um canal, visitante do chat do site).
  criadoPorId      String?         @map("criado_por_id") @db.Uuid
  criadoPor        Usuario?        @relation("ArquivoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm         DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  /// O conteúdo foi apagado do bucket (`ArquivosService.remover`); o registro fica para o histórico.
  removidoEm       DateTime?       @map("removido_em") @db.Timestamptz(3)

  mensagens        Mensagem[]
  chatMensagens    ChatMensagem[]
  respostasRapidas RespostaRapida[]

  @@index([contexto, criadoEm])
  @@index([criadoPorId])
  @@index([sha256])
  @@map("arquivos")
}

// ---------------------------------------------------------------------------
// Canais e filas do Atendimento (R12–R14)
// ---------------------------------------------------------------------------

/// Canal de atendimento: um número de WhatsApp, um chat de site, uma caixa de
/// e-mail, uma conta do Instagram ou uma página do Messenger. Configuração em
/// JSON sem segredos; os segredos ficam cifrados à parte (R10.3).
model Canal {
  id                  String           @id @default(uuid()) @db.Uuid
  tipo                TipoCanal
  nome                String
  ativo               Boolean          @default(true)
  /// Identificador do canal no provedor, para rotear o que chega: WHATSAPP =
  /// telefone conectado (E.164); EMAIL = endereço da caixa; INSTAGRAM = id da
  /// conta do Instagram; MESSENGER = id da página; WEBCHAT = chave pública do
  /// widget. Único por tipo entre os canais não excluídos.
  idExterno           String?          @map("id_externo")
  /// Configuração SEM segredos (host e porta do IMAP/SMTP, cores e domínios do
  /// widget, ids da Meta…). O formato é de cada módulo de canal.
  configuracao        Json             @default("{}")
  /// Segredos (senhas do IMAP/SMTP, app secret e token de página da Meta, token
  /// de verificação do webhook…) num JSON cifrado com AES-256-GCM
  /// (`CriptografiaService.cifrar`). Nunca sai da API; na tela, só mascarado.
  segredosCifrados    String?          @map("segredos_cifrados")
  /// Estado técnico mantido pelo módulo do canal (cursor do IMAP, última
  /// sincronização, validade do token…).
  estado              Json             @default("{}")
  ultimoErro          String?          @map("ultimo_erro")
  ultimoErroEm        DateTime?        @map("ultimo_erro_em") @db.Timestamptz(3)
  /// Fila das conversas novas deste canal (R12). Nula = sem fila.
  filaPadraoId        String?          @map("fila_padrao_id") @db.Uuid
  filaPadrao          FilaAtendimento? @relation(fields: [filaPadraoId], references: [id], onDelete: SetNull)
  /// Horário de atendimento: `{ fusoHorario: "America/Sao_Paulo", dias: { "1":
  /// [{ "inicio": "08:00", "fim": "18:00" }], … } }` (0 = domingo … 6 = sábado).
  /// Nulo = atende 24 horas.
  horarioAtendimento  Json?            @map("horario_atendimento")
  /// Resposta automática fora do horário (uma vez por conversa por período). Nula = não responde.
  mensagemForaHorario String?          @map("mensagem_fora_horario")
  /// Pede a nota de satisfação (1 a 5) ao resolver a conversa (R12).
  pesquisaSatisfacao  Boolean          @default(false) @map("pesquisa_satisfacao")
  /// Texto da pergunta de satisfação. Nulo = texto padrão.
  mensagemSatisfacao  String?          @map("mensagem_satisfacao")
  criadoPorId         String?          @map("criado_por_id") @db.Uuid
  criadoPor           Usuario?         @relation("CanalCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm            DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm        DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  excluidoEm          DateTime?        @map("excluido_em") @db.Timestamptz(3)

  whatsappNumero      WhatsappNumero?
  conversas           Conversa[]
  mensagens           Mensagem[]
  identificadores     ContatoIdentificador[]
  visitantes          WebchatVisitante[]

  @@unique([tipo, idExterno], map: "canais_tipo_id_externo_ativo_key", where: raw("((id_externo IS NOT NULL) AND (excluido_em IS NULL))"))
  @@index([tipo, ativo])
  @@map("canais")
}

/// Fila de atendimento de uma área (R12): SLA de primeira resposta e de
/// resolução e a estratégia de distribuição das conversas novas.
model FilaAtendimento {
  id                         String               @id @default(uuid()) @db.Uuid
  /// Identifica filas criadas pelo sistema (ex.: `comercial`), estável mesmo se renomeadas.
  chave                      String?              @unique
  nome                       String
  area                       Area
  descricao                  String?
  /// Prazo da primeira resposta, em minutos. Nulo = sem SLA.
  slaPrimeiraRespostaMinutos Int?                 @map("sla_primeira_resposta_minutos")
  /// Prazo de resolução, em minutos. Nulo = sem SLA.
  slaResolucaoMinutos        Int?                 @map("sla_resolucao_minutos")
  estrategia                 EstrategiaFila       @default(RODIZIO)
  /// Ponteiro do rodízio: trave a linha (`SELECT … FOR UPDATE`) antes de escolher o próximo.
  ultimoUsuarioId            String?              @map("ultimo_usuario_id") @db.Uuid
  ultimoUsuario              Usuario?             @relation("FilaUltimoUsuario", fields: [ultimoUsuarioId], references: [id], onDelete: SetNull)
  ativa                      Boolean              @default(true)
  criadoEm                   DateTime             @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm               DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  excluidoEm                 DateTime?            @map("excluido_em") @db.Timestamptz(3)

  participantes              FilaParticipante[]
  conversas                  Conversa[]
  canaisPadrao               Canal[]
  atribuicoesDe              ConversaAtribuicao[] @relation("AtribuicaoDeFila")
  atribuicoesPara            ConversaAtribuicao[] @relation("AtribuicaoParaFila")

  @@index([area, ativa])
  @@map("filas_atendimento")
}

/// Participantes da fila (opcional). Sem nenhuma linha com `participa = true`,
/// participam todos os membros ativos da área da fila que já ativaram o acesso;
/// `participa = false` tira a pessoa da distribuição.
model FilaParticipante {
  id           String          @id @default(uuid()) @db.Uuid
  filaId       String          @map("fila_id") @db.Uuid
  fila         FilaAtendimento @relation(fields: [filaId], references: [id], onDelete: Cascade)
  usuarioId    String          @map("usuario_id") @db.Uuid
  usuario      Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  participa    Boolean         @default(true)
  criadoEm     DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@unique([filaId, usuarioId])
  @@index([usuarioId])
  @@map("fila_participantes")
}

/// Liga uma pessoa num canal (telefone do WhatsApp, e-mail, id do Instagram ou
/// do Messenger, visitante do chat do site) ao contato do CRM. Único por tipo e valor.
model ContatoIdentificador {
  id           String            @id @default(uuid()) @db.Uuid
  contatoId    String            @map("contato_id") @db.Uuid
  contato      Contato           @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  tipo         TipoIdentificador
  /// Normalizado: telefone em E.164 só com dígitos, e-mail em minúsculas, ids como o provedor manda.
  valor        String
  /// Canal em que o identificador apareceu primeiro.
  canalId      String?           @map("canal_id") @db.Uuid
  canal        Canal?            @relation(fields: [canalId], references: [id], onDelete: SetNull)
  /// Nome de exibição no canal (pushName do WhatsApp, nome do perfil no Instagram…).
  nomeExibicao String?           @map("nome_exibicao")
  /// Extras do canal (ex.: `username` do Instagram, foto de perfil).
  dados        Json?
  /// Última mensagem recebida com este identificador.
  ultimoUsoEm  DateTime?         @map("ultimo_uso_em") @db.Timestamptz(3)
  criadoEm     DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@unique([tipo, valor])
  @@index([contatoId])
  @@map("contato_identificadores")
}

// ---------------------------------------------------------------------------
// Conversas e mensagens (R12)
// ---------------------------------------------------------------------------

/// Conversa de um contato num canal. Um contato tem no máximo uma conversa em
/// aberto (ABERTA ou PENDENTE) por canal — índice único parcial (R12).
model Conversa {
  id                           String               @id @default(uuid()) @db.Uuid
  canalId                      String               @map("canal_id") @db.Uuid
  canal                        Canal                @relation(fields: [canalId], references: [id], onDelete: Restrict)
  contatoId                    String               @map("contato_id") @db.Uuid
  contato                      Contato              @relation(fields: [contatoId], references: [id], onDelete: Restrict)
  filaId                       String?              @map("fila_id") @db.Uuid
  fila                         FilaAtendimento?     @relation(fields: [filaId], references: [id], onDelete: SetNull)
  /// Nulo = sem responsável (quem atende a fila pode assumir, R12).
  responsavelId                String?              @map("responsavel_id") @db.Uuid
  responsavel                  Usuario?             @relation("ConversaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  /// Quando o responsável atual recebeu a conversa.
  atribuidaEm                  DateTime?            @map("atribuida_em") @db.Timestamptz(3)
  status                       StatusConversa       @default(ABERTA)
  prioridade                   PrioridadeConversa   @default(NORMAL)
  assunto                      String?
  /// Id da conversa no provedor (jid do WhatsApp, Message-ID da raiz do e-mail,
  /// id da conversa da Meta, visitante do chat do site).
  idExterno                    String?              @map("id_externo")
  etiquetas                    String[]             @default([])
  /// Negócio ligado à conversa (ex.: criado a partir dela).
  negocioId                    String?              @map("negocio_id") @db.Uuid
  negocio                      Negocio?             @relation(fields: [negocioId], references: [id], onDelete: SetNull)
  /// Última mensagem (para a prévia na lista de conversas).
  ultimaMensagemId             String?              @unique @map("ultima_mensagem_id") @db.Uuid
  ultimaMensagem               Mensagem?            @relation("ConversaUltimaMensagem", fields: [ultimaMensagemId], references: [id], onDelete: SetNull)
  ultimaMensagemEm             DateTime?            @map("ultima_mensagem_em") @db.Timestamptz(3)
  /// Última mensagem do contato: base da janela de 24 h da Meta e do "aguardando".
  ultimaEntradaEm              DateTime?            @map("ultima_entrada_em") @db.Timestamptz(3)
  /// Desde quando o contato espera resposta (primeira entrada sem resposta). Nulo = ninguém esperando.
  aguardandoDesde              DateTime?            @map("aguardando_desde") @db.Timestamptz(3)
  /// Mensagens do contato ainda não lidas pela equipe.
  naoLidas                     Int                  @default(0) @map("nao_lidas")
  /// Primeira resposta da equipe ao contato (SLA de primeira resposta).
  primeiraRespostaEm           DateTime?            @map("primeira_resposta_em") @db.Timestamptz(3)
  resolvidaEm                  DateTime?            @map("resolvida_em") @db.Timestamptz(3)
  resolvidaPorId               String?              @map("resolvida_por_id") @db.Uuid
  resolvidaPor                 Usuario?             @relation("ConversaResolvidaPor", fields: [resolvidaPorId], references: [id], onDelete: SetNull)
  reaberturas                  Int                  @default(0)
  /// Prazos do SLA da fila (R12), calculados quando a conversa entra na fila.
  slaPrimeiraRespostaAte       DateTime?            @map("sla_primeira_resposta_ate") @db.Timestamptz(3)
  slaResolucaoAte              DateTime?            @map("sla_resolucao_ate") @db.Timestamptz(3)
  /// Quando o líder foi avisado do estouro (uma vez por prazo).
  slaPrimeiraRespostaAvisadoEm DateTime?            @map("sla_primeira_resposta_avisado_em") @db.Timestamptz(3)
  slaResolucaoAvisadoEm        DateTime?            @map("sla_resolucao_avisado_em") @db.Timestamptz(3)
  /// A resposta automática de fora do horário já foi enviada neste período.
  foraHorarioRespondidoEm      DateTime?            @map("fora_horario_respondido_em") @db.Timestamptz(3)
  /// Pesquisa de satisfação (R12): pedida ao resolver, vale por 24 h.
  satisfacaoSolicitadaEm       DateTime?            @map("satisfacao_solicitada_em") @db.Timestamptz(3)
  /// 1 a 5 (CHECK).
  satisfacaoNota               Int?                 @map("satisfacao_nota")
  satisfacaoComentario         String?              @map("satisfacao_comentario")
  satisfacaoRespondidaEm       DateTime?            @map("satisfacao_respondida_em") @db.Timestamptz(3)
  /// Janela de 24 h da Meta (Instagram, Messenger): até quando cabe resposta comum.
  janelaAte                    DateTime?            @map("janela_ate") @db.Timestamptz(3)
  criadoEm                     DateTime             @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm                 DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  mensagens                    Mensagem[]           @relation("MensagensDaConversa")
  atribuicoes                  ConversaAtribuicao[]
  visitantes                   WebchatVisitante[]

  @@unique([canalId, contatoId], map: "conversas_uma_em_aberto_key", where: raw("(status <> 'RESOLVIDA'::status_conversa)"))
  @@index([status, filaId])
  @@index([responsavelId, status])
  @@index([contatoId, criadoEm])
  @@index([canalId, idExterno])
  @@index([status, ultimaMensagemEm])
  @@index([negocioId])
  @@map("conversas")
}

/// Mensagem de uma conversa. `canalId` repete o canal da conversa para achar a
/// mensagem pelo id externo (status de entrega, respostas, encadeamento do
/// e-mail) — e o par é único, o que torna a entrada idempotente.
model Mensagem {
  id             String          @id @default(uuid()) @db.Uuid
  conversaId     String          @map("conversa_id") @db.Uuid
  conversa       Conversa        @relation("MensagensDaConversa", fields: [conversaId], references: [id], onDelete: Cascade)
  canalId        String          @map("canal_id") @db.Uuid
  canal          Canal           @relation(fields: [canalId], references: [id], onDelete: Restrict)
  direcao        DirecaoMensagem
  tipo           TipoMensagem    @default(TEXTO)
  /// Texto puro (o e-mail chega aqui como texto, nunca HTML).
  texto          String?
  arquivoId      String?         @map("arquivo_id") @db.Uuid
  arquivo        Arquivo?        @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  /// Quem escreveu (saída, nota interna). Na entrada, o autor é o contato da conversa.
  autorId        String?         @map("autor_id") @db.Uuid
  autor          Usuario?        @relation("MensagemAutor", fields: [autorId], references: [id], onDelete: SetNull)
  /// `USUARIO`, `SISTEMA`, `AUTOMACAO` (chatbot, disparo) ou `IA`. Nulo na entrada.
  autorTipo      TipoAtor?       @map("autor_tipo")
  /// Só na saída (CHECK): PENDENTE → ENVIADA → ENTREGUE → LIDA, ou FALHOU com `erro`.
  status         StatusMensagem?
  /// Motivo da falha, em português (mostrado na bolha com "tentar de novo").
  erro           String?
  tentativas     Int             @default(0)
  /// Id da mensagem no provedor (id do WhatsApp, Message-ID do e-mail, mid da Meta…).
  idExterno      String?         @map("id_externo")
  /// Mensagem respondida (citação).
  respostaAId    String?         @map("resposta_a_id") @db.Uuid
  respostaA      Mensagem?       @relation("MensagemResposta", fields: [respostaAId], references: [id], onDelete: SetNull)
  respostas      Mensagem[]      @relation("MensagemResposta")
  /// Detalhes por tipo e canal: localização `{ latitude, longitude, nome? }`,
  /// contato `{ vcard }`, reação `{ emoji }`, e-mail `{ messageId, inReplyTo,
  /// references[], de, para[], cc[], assunto }`, id citado ainda desconhecido
  /// (`respondeAIdExterno`) etc.
  metadados      Json?
  /// Quando aconteceu (ordem da conversa): o horário do provedor na entrada, o da criação na saída.
  ocorridaEm     DateTime        @default(now()) @map("ocorrida_em") @db.Timestamptz(3)
  enviadaEm      DateTime?       @map("enviada_em") @db.Timestamptz(3)
  entregueEm     DateTime?       @map("entregue_em") @db.Timestamptz(3)
  /// Saída: lida pelo contato. Entrada: lida pela equipe.
  lidaEm         DateTime?       @map("lida_em") @db.Timestamptz(3)
  editadaEm      DateTime?       @map("editada_em") @db.Timestamptz(3)
  excluidaEm     DateTime?       @map("excluida_em") @db.Timestamptz(3)
  criadoEm       DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  conversaUltima Conversa?       @relation("ConversaUltimaMensagem")

  @@unique([canalId, idExterno])
  @@index([conversaId, ocorridaEm])
  @@index([autorId, criadoEm])
  @@index([status, criadoEm])
  @@map("mensagens")
}

/// Histórico de quem cuidou da conversa (R12): distribuição, assumir,
/// transferência com nota, desligamento, reabertura. Base das métricas por pessoa.
model ConversaAtribuicao {
  id            String           @id @default(uuid()) @db.Uuid
  conversaId    String           @map("conversa_id") @db.Uuid
  conversa      Conversa         @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  motivo        MotivoAtribuicao
  deUsuarioId   String?          @map("de_usuario_id") @db.Uuid
  deUsuario     Usuario?         @relation("AtribuicaoDeUsuario", fields: [deUsuarioId], references: [id], onDelete: SetNull)
  paraUsuarioId String?          @map("para_usuario_id") @db.Uuid
  paraUsuario   Usuario?         @relation("AtribuicaoParaUsuario", fields: [paraUsuarioId], references: [id], onDelete: SetNull)
  deFilaId      String?          @map("de_fila_id") @db.Uuid
  deFila        FilaAtendimento? @relation("AtribuicaoDeFila", fields: [deFilaId], references: [id], onDelete: SetNull)
  paraFilaId    String?          @map("para_fila_id") @db.Uuid
  paraFila      FilaAtendimento? @relation("AtribuicaoParaFila", fields: [paraFilaId], references: [id], onDelete: SetNull)
  /// Nota da transferência.
  nota          String?
  /// Quem fez (nulo = o sistema ou uma automação).
  porUsuarioId  String?          @map("por_usuario_id") @db.Uuid
  porUsuario    Usuario?         @relation("AtribuicaoPorUsuario", fields: [porUsuarioId], references: [id], onDelete: SetNull)
  tipoAtor      TipoAtor         @map("tipo_ator")
  criadoEm      DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([conversaId, criadoEm])
  @@index([paraUsuarioId, criadoEm])
  @@map("conversa_atribuicoes")
}

/// Resposta rápida ("/atalho" no compositor) com variáveis (`{{contato.nome}}`…).
/// Global (`area` nula) ou de uma área. O atalho é único no seu escopo.
model RespostaRapida {
  id           String    @id @default(uuid()) @db.Uuid
  /// Sem a barra, em minúsculas e sem espaços (CHECK), ex.: `boas-vindas`.
  atalho       String
  titulo       String
  texto        String
  /// Nula = vale para todas as áreas.
  area         Area?
  /// Anexo opcional.
  arquivoId    String?   @map("arquivo_id") @db.Uuid
  arquivo      Arquivo?  @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  ativa        Boolean   @default(true)
  criadoPorId  String?   @map("criado_por_id") @db.Uuid
  criadoPor    Usuario?  @relation("RespostaRapidaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  excluidoEm   DateTime? @map("excluido_em") @db.Timestamptz(3)

  @@unique([atalho], map: "respostas_rapidas_atalho_global_key", where: raw("((area IS NULL) AND (excluido_em IS NULL))"))
  @@unique([area, atalho], map: "respostas_rapidas_area_atalho_key", where: raw("((area IS NOT NULL) AND (excluido_em IS NULL))"))
  @@map("respostas_rapidas")
}

/// Visitante do chat do site (R14). O widget guarda um token anônimo; o banco,
/// só o SHA-256. O contato nasce do formulário inicial (nome, e-mail ou
/// telefone, consentimento LGPD).
model WebchatVisitante {
  id              String    @id @default(uuid()) @db.Uuid
  canalId         String    @map("canal_id") @db.Uuid
  canal           Canal     @relation(fields: [canalId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique @map("token_hash")
  contatoId       String?   @map("contato_id") @db.Uuid
  contato         Contato?  @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  /// Conversa atual do visitante.
  conversaId      String?   @map("conversa_id") @db.Uuid
  conversa        Conversa? @relation(fields: [conversaId], references: [id], onDelete: SetNull)
  consentimentoEm DateTime? @map("consentimento_em") @db.Timestamptz(3)
  ip              String?
  userAgent       String?   @map("user_agent")
  /// Página em que o widget foi aberto.
  pagina          String?
  ultimoAcessoEm  DateTime  @default(now()) @map("ultimo_acesso_em") @db.Timestamptz(3)
  expiraEm        DateTime? @map("expira_em") @db.Timestamptz(3)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@index([canalId, ultimoAcessoEm])
  @@index([contatoId])
  @@map("webchat_visitantes")
}

// ---------------------------------------------------------------------------
// Gateway de WhatsApp (R13)
// ---------------------------------------------------------------------------

/// Número de WhatsApp conectado pelo gateway próprio (Baileys). Um por canal
/// `WHATSAPP`. Limites, aquecimento e pausa são as proteções anti-banimento.
model WhatsappNumero {
  id                      String                @id @default(uuid()) @db.Uuid
  canalId                 String                @unique @map("canal_id") @db.Uuid
  canal                   Canal                 @relation(fields: [canalId], references: [id], onDelete: Cascade)
  nome                    String
  /// Telefone conectado (E.164 só com dígitos), conhecido depois da leitura do QR.
  telefone                String?
  /// JID e LID da conta conectada (`5511…@s.whatsapp.net`, `…@lid`).
  jid                     String?
  lid                     String?
  status                  StatusWhatsapp        @default(DESCONECTADO)
  /// Por que está nesse status (erro, banimento, desconectado pelo celular…), em português.
  motivo                  String?
  /// Envios por dia depois do aquecimento.
  limiteDiario            Int                   @default(1000) @map("limite_diario")
  /// Ritmo: espera aleatória entre o mínimo e o máximo entre dois envios, em segundos.
  intervaloMinimoSegundos Int                   @default(2) @map("intervalo_minimo_segundos")
  intervaloMaximoSegundos Int                   @default(6) @map("intervalo_maximo_segundos")
  /// Aquecimento de número novo: a partir daqui, por `aquecimentoDias`, o limite diário cresce aos poucos.
  aquecimentoInicioEm     DateTime?             @map("aquecimento_inicio_em") @db.Timestamptz(3)
  aquecimentoDias         Int                   @default(14) @map("aquecimento_dias")
  /// Pausa manual ou automática (erro grave): nada sai por este número enquanto não nulo.
  pausadoEm               DateTime?             @map("pausado_em") @db.Timestamptz(3)
  pausaMotivo             String?               @map("pausa_motivo")
  /// Outras opções do gateway (ex.: ritmo próprio dos disparos), em JSON.
  configuracao            Json                  @default("{}")
  /// Tentativas seguidas de reconexão (espera crescente); zera ao conectar.
  tentativasReconexao     Int                   @default(0) @map("tentativas_reconexao")
  conectadoEm             DateTime?             @map("conectado_em") @db.Timestamptz(3)
  desconectadoEm          DateTime?             @map("desconectado_em") @db.Timestamptz(3)
  ultimoQrEm              DateTime?             @map("ultimo_qr_em") @db.Timestamptz(3)
  ultimoEventoEm          DateTime?             @map("ultimo_evento_em") @db.Timestamptz(3)
  criadoEm                DateTime              @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm            DateTime              @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  chaves                  WhatsappChave[]
  enviosDiarios           WhatsappEnvioDiario[]

  @@index([status])
  @@map("whatsapp_numeros")
}

/// Estado de autenticação do Baileys de um número, no Postgres e cifrado (nada em disco):
/// `creds` e as chaves do Signal, uma linha por (tipo, id).
model WhatsappChave {
  numeroId     String         @map("numero_id") @db.Uuid
  numero       WhatsappNumero @relation(fields: [numeroId], references: [id], onDelete: Cascade)
  /// `creds` ou o tipo de chave do Baileys (`pre-key`, `session`, `sender-key`, `app-state-sync-key`…).
  tipo         String
  /// Id da chave dentro do tipo (vazio em `creds`).
  chaveId      String         @map("chave_id")
  /// JSON (com o `BufferJSON` do Baileys) cifrado com AES-256-GCM e `CHAVE_CRIPTOGRAFIA`.
  valorCifrado String         @map("valor_cifrado")
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@id([numeroId, tipo, chaveId])
  @@map("whatsapp_chaves")
}

/// Envios por número e dia (no fuso de São Paulo): base do limite diário e do aquecimento.
model WhatsappEnvioDiario {
  numeroId     String         @map("numero_id") @db.Uuid
  numero       WhatsappNumero @relation(fields: [numeroId], references: [id], onDelete: Cascade)
  dia          DateTime       @db.Date
  enviados     Int            @default(0)
  falhas       Int            @default(0)
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@id([numeroId, dia])
  @@map("whatsapp_envios_diarios")
}

/// Cache da verificação "este telefone tem WhatsApp?" (vale para todos os números).
model WhatsappVerificacao {
  /// E.164 só com dígitos.
  telefone     String   @id
  existe       Boolean
  jid          String?
  lid          String?
  verificadoEm DateTime @default(now()) @map("verificado_em") @db.Timestamptz(3)

  @@index([verificadoEm])
  @@map("whatsapp_verificacoes")
}

// ---------------------------------------------------------------------------
// Chat interno da equipe (R15)
// ---------------------------------------------------------------------------

/// Canal do chat interno: "Geral", um por área, grupos e conversas diretas.
/// `chave` identifica os canais criados pelo sistema e as diretas
/// (`geral`, `area:COMERCIAL`, `direto:<menor id>:<maior id>`), sem duplicar.
model ChatCanal {
  id               String         @id @default(uuid()) @db.Uuid
  tipo             TipoChatCanal
  chave            String?        @unique
  /// Nulo nas conversas diretas (o nome é o da outra pessoa).
  nome             String?
  descricao        String?
  /// Canais `AREA`.
  area             Area?
  criadoPorId      String?        @map("criado_por_id") @db.Uuid
  criadoPor        Usuario?       @relation("ChatCanalCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  ultimaMensagemEm DateTime?      @map("ultima_mensagem_em") @db.Timestamptz(3)
  arquivadoEm      DateTime?      @map("arquivado_em") @db.Timestamptz(3)
  criadoEm         DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  membros          ChatMembro[]
  mensagens        ChatMensagem[]

  @@index([tipo])
  @@map("chat_canais")
}

/// Membro de um canal do chat. `automatico` = entrou pelo papel (Geral, área) e
/// é mantido pelo sistema quando a pessoa muda de papel ou é desligada.
model ChatMembro {
  id              String    @id @default(uuid()) @db.Uuid
  canalId         String    @map("canal_id") @db.Uuid
  canal           ChatCanal @relation(fields: [canalId], references: [id], onDelete: Cascade)
  usuarioId       String    @map("usuario_id") @db.Uuid
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Pode renomear o grupo e adicionar/remover pessoas.
  administrador   Boolean   @default(false)
  automatico      Boolean   @default(false)
  silenciado      Boolean   @default(false)
  /// Até onde a pessoa leu (as não lidas são as mensagens depois disto).
  ultimaLeituraEm DateTime? @map("ultima_leitura_em") @db.Timestamptz(3)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@unique([canalId, usuarioId])
  @@index([usuarioId])
  @@map("chat_membros")
}

/// Mensagem do chat interno. `mencoes` guarda os ids dos usuários mencionados
/// (@nome); `referencias`, os itens citados (`[{ "tipo": "negocio" | "contato" |
/// "empresa", "id": "…" }]`), que viram links.
model ChatMensagem {
  id           String         @id @default(uuid()) @db.Uuid
  canalId      String         @map("canal_id") @db.Uuid
  canal        ChatCanal      @relation(fields: [canalId], references: [id], onDelete: Cascade)
  /// Nulo em avisos do sistema ("Fulano entrou no grupo").
  autorId      String?        @map("autor_id") @db.Uuid
  autor        Usuario?       @relation("ChatMensagemAutor", fields: [autorId], references: [id], onDelete: SetNull)
  texto        String?
  arquivoId    String?        @map("arquivo_id") @db.Uuid
  arquivo      Arquivo?       @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  mencoes      String[]       @default([]) @db.Uuid
  referencias  Json           @default("[]")
  respostaAId  String?        @map("resposta_a_id") @db.Uuid
  respostaA    ChatMensagem?  @relation("ChatMensagemResposta", fields: [respostaAId], references: [id], onDelete: SetNull)
  respostas    ChatMensagem[] @relation("ChatMensagemResposta")
  editadaEm    DateTime?      @map("editada_em") @db.Timestamptz(3)
  /// Exclusão lógica: o texto e o anexo somem para todos.
  excluidaEm   DateTime?      @map("excluida_em") @db.Timestamptz(3)
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@index([canalId, criadoEm])
  @@index([autorId, criadoEm])
  @@index([mencoes], type: Gin)
  @@map("chat_mensagens")
}
