# Variáveis da crmbrl-api. Copie para .env (que fica fora do git) e ajuste:
#
#   cp .env.example .env
#
# O .env tem dois leitores:
# - a API e o CLI do Prisma, rodando na máquina (`bun run start:dev`, migrations);
# - o docker compose, que monta as variáveis do serviço `api` a partir dele.
# O que já estiver definido no ambiente tem prioridade sobre o arquivo. Variável
# vazia vale como não definida: a API e o compose usam o padrão de cada um.

# --- API --------------------------------------------------------------------

# Conexão com o PostgreSQL (obrigatória para a API fora do Docker). Este valor
# aponta para o banco do docker compose (`docker compose up -d banco`),
# publicado em 127.0.0.1:5434. No compose, a API usa o banco pela rede interna.
DATABASE_URL=postgresql://crmbrl:crmbrl@localhost:5434/crmbrl?schema=public

# Porta HTTP da API (padrão 3000).
PORT=3000

# development | production | test. Aparece no campo "ambiente" de GET /api/saude.
# Em production ficam obrigatórias URL_PUBLICA e CHAVE_CRIPTOGRAFIA.
NODE_ENV=development

# Origens liberadas no CORS, separadas por vírgula (ex.: http://localhost:4200).
# Vazio = CORS desligado. Em geral não precisa: o front chega pela mesma origem,
# via proxy do `ng serve` em desenvolvimento e via Caddy no Docker.
CORS_ORIGENS=

# @nestjs/observe (traces, erros e métricas). Só liga com as duas chaves; sem
# elas o pacote nem é carregado. Gere as chaves em https://observe.nestjs.com.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Endereço e segurança ----------------------------------------------------

# Endereço público do CRM (o front), base dos links de e-mail e dos endereços
# de webhook. Vazio: http://localhost:4200 fora de produção (o compose usa
# http://localhost:8080). Obrigatória em produção, ex.: https://crm.brl.com.br
URL_PUBLICA=

# Origens aceitas em requisições que alteram dados (POST/PUT/PATCH/DELETE) e na
# conexão do tempo real (Socket.IO em /api/socket.io) — proteção CSRF (R2.9),
# pelo cabeçalho Origin ou Referer. Separadas por vírgula.
# Vazio: só a origem da URL_PUBLICA. Para usar o "Try it out" do Swagger direto
# na API, inclua http://localhost:3000.
ORIGENS_PERMITIDAS=http://localhost:4200,http://localhost:8080

# Cookie de sessão com o atributo Secure (só trafega em HTTPS). Vazio: true em
# produção, false fora dela. No compose local, em http, o padrão é false.
COOKIE_SEGURO=

# Chave AES-256-GCM que cifra os segredos dos webhooks e dos canais e as chaves
# do WhatsApp (R10.3): 32 bytes em base64 (ou 64 caracteres hexadecimais). Gere com `openssl rand -base64 32`.
# Obrigatória em produção; vazia em desenvolvimento usa uma chave pública de
# desenvolvimento (com aviso no log). Trocar a chave invalida os segredos já
# gravados.
CHAVE_CRIPTOGRAFIA=

# Sessões (R2.2): expiram após SESSAO_INATIVIDADE_DIAS sem uso e, em qualquer
# caso, SESSAO_DURACAO_MAXIMA_DIAS após o login. O uso renova a validade,
# gravando no máximo a cada SESSAO_RENOVACAO_MINUTOS.
SESSAO_INATIVIDADE_DIAS=7
SESSAO_DURACAO_MAXIMA_DIAS=30
SESSAO_RENOVACAO_MINUTOS=5

# --- Primeiro acesso (R2.6) -----------------------------------------------------
# Se o banco não tem nenhum usuário, a API cria este Admin, com troca de senha
# obrigatória no primeiro login. Sem ADMIN_SENHA_INICIAL (8 a 128 caracteres), a
# API gera uma senha e a mostra uma única vez no log da inicialização.

ADMIN_EMAIL=admin@crmbrl.local
ADMIN_NOME=Administrador
ADMIN_SENHA_INICIAL=

# --- E-mail (SMTP, R2.8) -----------------------------------------------------
# Sem SMTP_HOST, convite e "esqueci minha senha" ficam indisponíveis (o Admin
# define senhas temporárias). SMTP_SEGURO=true para TLS direto (porta 465);
# vazio = true só na porta 465 (nas outras, STARTTLS quando o servidor oferece).

SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=
SMTP_USUARIO=
SMTP_SENHA=
# Remetente, ex.: BRL CRM <crm@brl.com.br> (obrigatório com SMTP_HOST).
SMTP_REMETENTE=

# --- Integrações ---------------------------------------------------------------

# Webhooks de saída podem chamar endereços de rede interna ou localhost (ex.:
# TicketHub na mesma rede). Padrão false: proteção contra SSRF (R9.1).
WEBHOOKS_PERMITIR_REDE_INTERNA=false

# --- Arquivos (R11) --------------------------------------------------------------
# Anexos, mídia do Atendimento e do chat, fotos e importações ficam num bucket
# S3 (o MinIO do serviço "arquivos" no docker compose). O download passa sempre
# pela API, com a permissão do item. O bucket é criado pela API ao subir.

# s3 (MinIO/S3) ou memoria (só para testes: os arquivos somem ao reiniciar).
ARQUIVOS_DRIVER=s3
# Endereço do S3/MinIO. Vazio: http://localhost:9000 fora de produção (no
# compose, http://arquivos:9000; o MinIO não publica porta no host).
ARQUIVOS_ENDPOINT=
ARQUIVOS_REGIAO=us-east-1
# Credenciais do MinIO: o compose usa as mesmas para criar o usuário raiz dele.
# Obrigatórias em produção (o segredo com 8+ caracteres; gere com
# `openssl rand -base64 24`). Vazias fora de produção: a API sobe com aviso e o
# envio de arquivos falha até configurar.
ARQUIVOS_CHAVE=
ARQUIVOS_SEGREDO=
ARQUIVOS_BUCKET=crmbrl

# --- Gateway de WhatsApp (R13) -------------------------------------------------------
# O gateway é outro processo da mesma imagem (`node dist/whatsapp/main.js`,
# serviço "whatsapp" do compose). A API manda os comandos (conectar, QR,
# desconectar, verificar número) pelo HTTP interno e as mensagens pela fila.

# Endereço interno do gateway visto pela API. Vazio: http://localhost:WHATSAPP_PORTA
# (no compose, http://whatsapp:3100).
WHATSAPP_URL_INTERNA=
# Porta HTTP interna do gateway (padrão 3100; nunca publicada no host).
WHATSAPP_PORTA=3100
# Segredo compartilhado entre a API e o gateway (cabeçalho X-Token-Interno), com
# 32+ caracteres: `openssl rand -base64 32`. Obrigatório em produção; vazio fora
# dela usa um token público de desenvolvimento (com aviso no log).
WHATSAPP_TOKEN_INTERNO=
# true = transporte simulado: QR de mentira, "conecta" em segundos, envios com
# status progressivo e POST /simulador/receber no HTTP interno. Para
# desenvolvimento, testes e demonstrações — nenhum WhatsApp de verdade.
WHATSAPP_SIMULADO=false

# --- Meta: Instagram e Messenger (R14) ----------------------------------------------
# Base e versão da Graph API (a do ambiente de testes pode ser uma falsa).
META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_VERSAO=v24.0

# --- Operação --------------------------------------------------------------------

# Documentação OpenAPI em /api/docs para qualquer um. Vazio: true fora de
# produção; em produção, só o Admin logado vê.
DOCS_PUBLICAS=

# Trabalhadores da fila (pg-boss), jobs agendados e despachante de eventos.
# false = réplica que só atende HTTP (os testes usam false e drenam na hora).
# Vale também para o gateway de WhatsApp (as filas de envio dos números).
PROCESSAR_FILAS=true

# json (uma linha JSON por registro) ou texto. Vazio: json em produção, texto
# fora dela.
LOG_FORMATO=

# --- Testes de integração (npm run test:e2e) ------------------------------------
# Banco DESCARTÁVEL: os testes apagam tudo nele. Nunca o banco do compose (5434).
#   docker run -d --name crmbrl-teste -e POSTGRES_USER=crmbrl -e POSTGRES_PASSWORD=crmbrl \
#     -e POSTGRES_DB=crmbrl -p 127.0.0.1:55432:5432 postgres:17-alpine
# DATABASE_URL_TESTE=postgresql://crmbrl:crmbrl@localhost:55432/crmbrl

# --- Container da API (docker-entrypoint.sh) -------------------------------

# "false" pula o `prisma migrate deploy` que roda antes de a API subir.
MIGRAR_AO_INICIAR=true

# --- docker compose (docker-compose.yml) -----------------------------------
# Lidas pelo compose deste diretório. Se mudar as credenciais do banco, mude
# também a DATABASE_URL lá em cima. A API fica publicada só em 127.0.0.1
# (API_PORTA); o front (WEB_PORTA) é a porta de entrada do CRM.

BANCO_USUARIO=crmbrl
BANCO_SENHA=crmbrl
BANCO_NOME=crmbrl
BANCO_PORTA=5434
API_PORTA=3000
WEB_PORTA=8080
FRONT_DIR=../crmbrl
